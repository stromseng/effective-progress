{
  "name": "effective-progress",
  "version": "0.6.2",
  "description": "Effect-first terminal progress bars with nested multibar support",
  "homepage": "https://github.com/stromseng/effective-progress#readme",
  "bugs": {
    "url": "https://github.com/stromseng/effective-progress/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stromseng/effective-progress.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "effect-language-service patch",
    "build": "tsdown",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "fast-string-width": "^3.0.2",
    "ink": "^6.8.0",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@effect/language-service": "^0.73.1",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "effect": "^3.19.17",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "tsdown": "^0.21.0-beta.2",
    "typescript": "^5"
  },
  "peerDependencies": {
    "effect": "^3.19.17"
  },
  "engines": {
    "node": ">=20.12.0"
  }
}
